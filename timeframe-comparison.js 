const NOTE =
  "Historical comparison only. No forecasts, probabilities or trading recommendations.";

function isValidReport(report, expectedTimeframe) {
  return Boolean(
    report &&
    report.status === "OK" &&
    report.dataType === "HISTORICAL_ONLY" &&
    report.reportInfo &&
    report.reportInfo.timeframe === expectedTimeframe &&
    report.sections
  );
}

function createSnapshot(report, timeframe) {
  const sections = report.sections;

  return {
    timeframe,
    status: "VALID",
    candleCount: report.reportInfo.candleCount,

    dataQuality: {
      quality: sections.dataQuality?.quality ?? "UNKNOWN",
      issueCount: sections.dataQuality?.issueCount ?? null
    },

    historicalTrend:
      sections.marketStructure?.trend ?? "UNKNOWN",

    marketStructure: {
      pivotHighCount:
        sections.marketStructure?.pivotHighCount ?? 0,
      pivotLowCount:
        sections.marketStructure?.pivotLowCount ?? 0,
      structureEventCount:
        sections.marketStructure?.structureEventCount ?? 0
    },

    supportResistance: {
      supportCount:
        sections.supportResistance?.supportCount ?? 0,
      resistanceCount:
        sections.supportResistance?.resistanceCount ?? 0
    },

    fibonacci: {
      swing: sections.fibonacci?.swing ?? null
    },

    candlePatterns: {
      totalPatterns:
        sections.candlePatterns?.totalPatterns ?? 0
    }
  };
}

export function compareHistoricalTimeframes(
  dailyReport,
  intradayReport
) {
  try {
    if (!isValidReport(dailyReport, "1d")) {
      throw new Error("Valid 1D historical report is required.");
    }

    const daily = createSnapshot(dailyReport, "1D");

    if (!intradayReport) {
      return {
        status: "WAITING_FOR_DATA",
        version: "12.0",
        module: "TIMEFRAME_COMPARISON",
        dataType: "HISTORICAL_ONLY",
        availableTimeframes: ["1D"],
        waitingTimeframes: ["15M"],
        daily,
        intraday: null,
        comparison: null,
        note: NOTE
      };
    }

    if (!isValidReport(intradayReport, "15m")) {
      throw new Error("Valid 15M historical report is required.");
    }

    const intraday = createSnapshot(
      intradayReport,
      "15M"
    );

    return {
      status: "OK",
      version: "12.0",
      module: "TIMEFRAME_COMPARISON",
      dataType: "HISTORICAL_ONLY",

      availableTimeframes: ["1D", "15M"],
      waitingTimeframes: [],

      daily,
      intraday,

      comparison: {
        trendClassificationMatches:
          daily.historicalTrend === intraday.historicalTrend,

        dataQualityMatches:
          daily.dataQuality.quality ===
          intraday.dataQuality.quality,

        candleCounts: {
          daily: daily.candleCount,
          intraday: intraday.candleCount
        }
      },

      note: NOTE
    };

  } catch (error) {
    return {
      status: "ERROR",
      version: "12.0",
      module: "TIMEFRAME_COMPARISON",
      dataType: "HISTORICAL_ONLY",
      error: error.message,
      note: NOTE
    };
  }
}
